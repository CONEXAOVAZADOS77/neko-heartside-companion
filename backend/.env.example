# Rode a API nesta mesma máquina da GPU alugada.
PORT=8787

# ComfyUI só em localhost. Não abra a porta 8188 na internet.
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# Endereço público da API, o mesmo que o site usa em VITE_MEDIA_API.
# Exemplo: http://IP_DA_GPU:8787
PUBLIC_BASE_URL=http://IP_DA_GPU:8787

# Nomes exatos dos arquivos já instalados no ComfyUI dessa GPU.
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_VIDEO_CHECKPOINT=svd.safetensors

# Origem do site, ou * enquanto estiver testando.
CORS_ORIGIN=*
